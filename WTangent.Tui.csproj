<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10"/>
    <PackageReference Include="System.CommandLine" Version="2.0.10"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10"/>
    <!-- 覆盖传递依赖：Microsoft.Data.Sqlite 捆绑的 bundle_e_sqlite3 2.1.11 含 SQLite <3.50.2 漏洞（CVE-2025-6965，无补丁），显式提升到 2.1.12 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12"/>
    <PackageReference Include="Terminal.Gui" Version="2.4.17"/>
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7"/>
  </ItemGroup>

  <PropertyGroup>
    <!-- 组件 = 纯 dll（Library）：空壳 ALC 加载后经 Entry.Run(args) 调用；无独立可执行 -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 版本号与 release tag 对齐；release-please 管理 -->
    <Version>0.6.0</Version>
    <RootNamespace>WTangent.Tui</RootNamespace>
    <AssemblyName>agent-client</AssemblyName>
  </PropertyGroup>


  <!-- Core/生成器:平级 WTangent.Components 仓源码引用(工作区与 CI 同布局)。
       WTangentDev=true = wtangent dev restore 的直拉引用模式(props 注入 HintPath/Analyzer),关闭源码引用。
       Private=false:Core 由空壳运行时统一提供(单 ALC),不拷进组件输出/zip -->
  <ItemGroup Condition="'$(WTangentDev)' != 'true'">
    <ProjectReference Include="..\WTangent.Components\src\WTangent.Core\WTangent.Core.csproj" Private="false"/>
    <ProjectReference Include="..\WTangent.Components\src\WTangent.Components\Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Private="false"/>
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ProjectDir"/>
    <CompilerVisibleProperty Include="AssemblyName"/>
    <CompilerVisibleProperty Include="ComponentDepends"/>
  </ItemGroup>

  <ItemGroup>
    <!-- 特性类（AgentEntry/AgentCommand 等）在 Core 程序集里、命名空间 WTangent.Components -->
    <Using Include="WTangent.Components"/>
  </ItemGroup>

  <ItemGroup>
    <!-- 不用全局 WTangent.Core：契约 Application 与 Terminal.Gui.App.Application 撞名；需要处显式 using -->
  </ItemGroup>
</Project>
